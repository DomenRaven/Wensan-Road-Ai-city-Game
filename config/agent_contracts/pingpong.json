{
  "genre": "pingpong",
  "bridge_apis": [
    {
      "name": "get_player",
      "sig": "() -> Node",
      "desc": "兼容入口；乒乓请优先 get_player_node 或 $PlayerPaddle（Area2D）"
    },
    {
      "name": "get_player_node",
      "sig": "() -> Node",
      "desc": "玩家节点（拍子为 Area2D/PlayerPaddle，非 CharacterBody2D）"
    },
    {
      "name": "get_game_manager",
      "sig": "() -> Node",
      "desc": "主场景"
    },
    {
      "name": "watch_coins",
      "sig": "(cb: Callable) -> void",
      "desc": "少用"
    },
    {
      "name": "get_coin_count",
      "sig": "() -> int",
      "desc": "计数"
    },
    {
      "name": "grant_invincibility",
      "sig": "(seconds: float) -> void",
      "desc": "无敌"
    },
    {
      "name": "boost_move_speed",
      "sig": "(multiplier: float, seconds: float) -> void",
      "desc": "移速"
    },
    {
      "name": "show_countdown",
      "sig": "(seconds: float, title: String) -> void",
      "desc": "倒计时"
    },
    {
      "name": "flash_player_fx",
      "sig": "(seconds: float) -> void",
      "desc": "闪烁"
    },
    {
      "name": "set_tuning_number",
      "sig": "(dotted_path: String, value: float) -> void",
      "desc": "球速等数值"
    },
    {
      "name": "ensure_touch_action",
      "sig": "(action_id: String, label: String) -> void",
      "desc": "通用触屏按钮"
    }
  ],
  "catalog_skills": [
    {
      "id": "power_smash",
      "label": "大力扣杀",
      "desc": "球速暴增一球",
      "trigger": "触屏技能键",
      "runtime": {
        "input": "action:skill",
        "effect": "catalog:power_smash",
        "touch": "overlay|ensure_touch_action"
      }
    },
    {
      "id": "curve_ball",
      "label": "旋转球",
      "desc": "大角度变向",
      "trigger": "触屏技能键",
      "runtime": {
        "input": "action:skill",
        "effect": "catalog:curve_ball",
        "touch": "overlay|ensure_touch_action"
      }
    }
  ],
  "edit_recipes": [
    {
      "intent": "开扣杀/旋转球",
      "action": "enable_catalog_skill",
      "paths": "config/game_config.json",
      "hint": "power_smash / curve_ball"
    },
    {
      "intent": "改球速",
      "action": "set_tuning_or_core",
      "paths": "set_tuning_number 或会话 core",
      "hint": "可改会话副本"
    },
    {
      "intent": "新机制",
      "action": "edit_session_core",
      "paths": "core/** scenes/**",
      "hint": "会话 core/scenes 自由实现用户所求；桥/catalog 为捷径"
    }
  ],
  "hooks": {
    "main_scene": "scenes/main.tscn",
    "config": "config/game_config.json",
    "sandbox": "core/ai_sandbox/"
  },
  "notes": [
    "品类技能以本品类 catalog/接线为准",
    "可改会话 core；templates 只读参考",
    "创作主路径：会话 core/** scenes/**；桥 API 与 catalog 可参考亦可会话另写",
    "需求对齐：实现所求机制；实现对齐用户所求机制本身"
  ],
  "forbidden_invented_apis": [
    "add_method",
    "bridge.add_method",
    "merge_overrides",
    "patch_tuning",
    "set_color(",
    "bullet.set_color"
  ]
}
