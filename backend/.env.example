# GameForge backend local env (optional)
# 复制为 backend/.env 后生效

# Redis（先运行 05-工具脚本/install_redis.ps1 + run_redis.ps1）
REDIS_URL=redis://127.0.0.1:6379/0
ALLOW_MEMORY_FALLBACK=true

# ── 7.20 教学并发（部署必写；代码默认 max_sessions=10，勿依赖默认）
# 展厅 / 机房均建议显式写出：
MAX_SESSIONS=70
# S4 · 同时「AI 改游戏」人数帽（建议 4～8）与排队等待秒数
MAX_CONCURRENT_AGENTS=6
AGENT_QUEUE_WAIT_SEC=90

# S2-路B · 试玩启动模式（展厅默认 server；机房共享盘映射用 local_share）
PLAY_LAUNCH_MODE=server
# PLAY_LAUNCH_MODE=local_share

# 学情 / 账号库（与 data/learned_skills 分离）
# LEARNING_ANALYTICS_DIR=../data/learning_analytics
# AUTH_TOKEN_TTL_SEC=604800
# 可选：启动时引导首个管理员（不走开放注册）
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NICKNAME=管理员

# Godot 4.6.3（与 .cursor/mcp.json 一致 · 展厅试玩用 GUI 版）
GODOT_PATH=F:\Godot\Godot_v4.6.3-stable_win64.exe\Godot_v4.6.3-stable_win64.exe

DEPLOYMENT_SERVER_OS=TBD
DEPLOYMENT_TERMINAL_LAYOUT=TBD

# 实装公网 HTTPS 域名（证书二维码编码此地址，游客手机有网即可扫码下载）
# 优先方案：配 Cloudflare Tunnel / frp / 馆内反代后填写此项
# PUBLIC_API_BASE=https://gameforge.example.com
# CERTIFICATE_DOWNLOAD_TTL_SEC=259200

# 无 PUBLIC_API_BASE 时：服务端把证书中继到临时图床（Litterbox 1h → SM.MS），
# 前端仍用本地 qrcodejs 生成二维码。会话结束会尽量 delete（SM.MS）；Litterbox 靠 1h TTL。
# CERTIFICATE_RELAY_ENABLED=true

# ── S-A2 · AI 改代码大模型（OpenAI / DeepSeek / 阿里云百炼 兼容 Chat Completions）
# 填入 LLM_API_KEY 后 nl-patch 走真 LLM；留空则 stub。
# DeepSeek：
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
# 阿里云百炼（OpenAI 兼容模式）：
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SEC=30

# HF-14 辅助：会话盘写 .agent/live_trace.jsonl，配合
#   python 05-工具脚本/watch_agent_live.py
# 实时盯 LLM 轮次 / 工具 / 门禁。默认 true；关：AGENT_LIVE_TRACE=false
# AGENT_LIVE_TRACE=true

# 馆内兼容网关示例（可选，若已以 /v1 结尾则请求接到该前缀）：
# LLM_BASE_URL=http://10.40.94.10:10010/v1
# LLM_API_KEY=
# LLM_MODEL=your-model-id

# 秒哒 Skill API（本地批量对标用，勿提交真实 Key）
# MIAODA_API_KEY=sk_xxx
